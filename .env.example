# Copy this file to .env and put one key in it. .env stays out of git.
# A key set in your environment, such as a Codespaces secret, wins over this file.

# The OpenRouter key from pre-work:
OPENROUTER_API_KEY=

# Or, if you have an OpenAI key instead, leave the line above empty and use this one:
OPENAI_API_KEY=
